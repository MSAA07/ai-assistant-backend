# Replace placeholders before running locally. Never commit real secrets.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require" # PostgreSQL connection string for Prisma.

# Better Auth / Auth
BETTER_AUTH_URL="YOUR_BACKEND_AUTH_URL_HERE" # Public Better Auth base URL, usually https://backend.example.com/api/auth.
BETTER_AUTH_BASE_URL="YOUR_BACKEND_AUTH_URL_HERE" # Fallback Better Auth base URL if BETTER_AUTH_URL is not set.
BETTER_AUTH_SECRET="YOUR_SECRET_HERE" # Long random secret used by Better Auth.
ADMIN_EMAILS="YOUR_ADMIN_EMAILS_HERE" # Comma-separated emails that should be elevated to admin.
AUTH_EMAIL_APP_URL="YOUR_FRONTEND_APP_URL_HERE" # Frontend app URL used for auth email links.
AUTH_VERIFICATION_CALLBACK_URL="YOUR_VERIFICATION_CALLBACK_URL_HERE" # Frontend callback URL for verification emails.
VITE_AUTH_VERIFICATION_CALLBACK_URL="YOUR_VERIFICATION_CALLBACK_URL_HERE" # Legacy/frontend-prefixed verification callback fallback.
AUTH_PASSWORD_RESET_CALLBACK_URL="YOUR_PASSWORD_RESET_CALLBACK_URL_HERE" # Frontend callback URL for password reset emails.
VITE_AUTH_PASSWORD_RESET_CALLBACK_URL="YOUR_PASSWORD_RESET_CALLBACK_URL_HERE" # Legacy/frontend-prefixed password reset callback fallback.

# Email (Resend)
AUTH_EMAIL_PROVIDER="resend" # Transactional email provider name.
AUTH_EMAIL_FROM_EMAIL="YOUR_FROM_EMAIL_HERE" # Sender email address for auth emails.
AUTH_EMAIL_FROM_NAME="Studymaxing" # Sender display name for auth emails.
AUTH_EMAIL_REPLY_TO="YOUR_REPLY_TO_EMAIL_HERE" # Reply-to email for auth emails.
AUTH_EMAIL_SUPPORT_EMAIL="YOUR_SUPPORT_EMAIL_HERE" # Support email shown in auth flows and emails.
RESEND_API_KEY="YOUR_RESEND_API_KEY_HERE" # Resend API key for transactional and alert emails.

# Turnstile / CAPTCHA
AUTH_CHALLENGE_PROVIDER="turnstile" # Auth challenge provider.
AUTH_TURNSTILE_SECRET_KEY="YOUR_TURNSTILE_SECRET_KEY_HERE" # Cloudflare Turnstile secret key.
AUTH_CHALLENGE_REQUIRE_SIGN_UP="true" # Require CAPTCHA for sign-up.
AUTH_CHALLENGE_REQUIRE_SIGN_IN="true" # Require CAPTCHA for sign-in.
AUTH_CHALLENGE_REQUIRE_FORGOT_PASSWORD="true" # Require CAPTCHA for forgot-password requests.
AUTH_CHALLENGE_REQUIRE_RESEND_VERIFICATION="false" # Require CAPTCHA for verification email resend.
AUTH_CHALLENGE_REQUIRE_RESET_PASSWORD="false" # Require CAPTCHA for password reset completion.
AUTH_CHALLENGE_REQUIRE_CHANGE_PASSWORD="false" # Require CAPTCHA for authenticated password change.
AUTH_CHALLENGE_REQUIRE_VERIFY_EMAIL="false" # Require CAPTCHA for email verification.
AUTH_CHALLENGE_REQUIRE_GET_SESSION="false" # Require CAPTCHA for session checks.

# Rate Limits
AUTH_RATE_LIMIT_SIGN_UP_IP_LIMIT="5" # Sign-up attempts allowed per IP.
AUTH_RATE_LIMIT_SIGN_UP_IP_WINDOW_MS="600000" # Sign-up IP rate-limit window in milliseconds.
AUTH_RATE_LIMIT_SIGN_UP_EMAIL_LIMIT="3" # Sign-up attempts allowed per email.
AUTH_RATE_LIMIT_SIGN_UP_EMAIL_WINDOW_MS="1800000" # Sign-up email rate-limit window in milliseconds.
AUTH_RATE_LIMIT_SIGN_IN_IP_LIMIT="10" # Sign-in attempts allowed per IP.
AUTH_RATE_LIMIT_SIGN_IN_IP_WINDOW_MS="600000" # Sign-in IP rate-limit window in milliseconds.
AUTH_RATE_LIMIT_SIGN_IN_EMAIL_LIMIT="6" # Sign-in attempts allowed per email.
AUTH_RATE_LIMIT_SIGN_IN_EMAIL_WINDOW_MS="600000" # Sign-in email rate-limit window in milliseconds.
AUTH_RATE_LIMIT_SIGN_IN_IP_EMAIL_LIMIT="5" # Sign-in attempts allowed per IP/email pair.
AUTH_RATE_LIMIT_SIGN_IN_IP_EMAIL_WINDOW_MS="600000" # Sign-in IP/email rate-limit window in milliseconds.
AUTH_RATE_LIMIT_RESEND_VERIFICATION_IP_LIMIT="5" # Verification resend attempts allowed per IP.
AUTH_RATE_LIMIT_RESEND_VERIFICATION_IP_WINDOW_MS="600000" # Verification resend IP window in milliseconds.
AUTH_RATE_LIMIT_RESEND_VERIFICATION_EMAIL_LIMIT="3" # Verification resend attempts allowed per email.
AUTH_RATE_LIMIT_RESEND_VERIFICATION_EMAIL_WINDOW_MS="1800000" # Verification resend email window in milliseconds.
AUTH_RATE_LIMIT_FORGOT_PASSWORD_IP_LIMIT="5" # Forgot-password attempts allowed per IP.
AUTH_RATE_LIMIT_FORGOT_PASSWORD_IP_WINDOW_MS="600000" # Forgot-password IP window in milliseconds.
AUTH_RATE_LIMIT_FORGOT_PASSWORD_EMAIL_LIMIT="3" # Forgot-password attempts allowed per email.
AUTH_RATE_LIMIT_FORGOT_PASSWORD_EMAIL_WINDOW_MS="1800000" # Forgot-password email window in milliseconds.
AUTH_RATE_LIMIT_RESET_PASSWORD_IP_LIMIT="5" # Password reset completions allowed per IP.
AUTH_RATE_LIMIT_RESET_PASSWORD_IP_WINDOW_MS="900000" # Password reset IP window in milliseconds.
AUTH_RATE_LIMIT_RESET_PASSWORD_TOKEN_LIMIT="3" # Password reset completions allowed per token.
AUTH_RATE_LIMIT_RESET_PASSWORD_TOKEN_WINDOW_MS="1800000" # Password reset token window in milliseconds.
AUTH_RATE_LIMIT_CHANGE_PASSWORD_IP_LIMIT="10" # Password change attempts allowed per IP.
AUTH_RATE_LIMIT_CHANGE_PASSWORD_IP_WINDOW_MS="900000" # Password change IP window in milliseconds.
AUTH_RATE_LIMIT_CHANGE_PASSWORD_SESSION_LIMIT="5" # Password change attempts allowed per session.
AUTH_RATE_LIMIT_CHANGE_PASSWORD_SESSION_WINDOW_MS="900000" # Password change session window in milliseconds.

# OpenAI
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE" # OpenAI API key for study material generation.

# Sentry
SENTRY_DSN="YOUR_SENTRY_DSN_HERE" # Sentry DSN for backend error reporting.
SENTRY_ENVIRONMENT="development" # Sentry environment label.

# Storage (R2)
R2_ENDPOINT="YOUR_R2_ENDPOINT_HERE" # Cloudflare R2 S3-compatible endpoint.
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID_HERE" # Cloudflare R2 access key ID.
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY_HERE" # Cloudflare R2 secret access key.
R2_BUCKET_NAME="YOUR_R2_BUCKET_NAME_HERE" # Cloudflare R2 bucket name.

# Deployment / Origins
NODE_ENV="development" # Node runtime environment.
PORT="3001" # HTTP port for the API server.
FRONTEND_ORIGINS="YOUR_FRONTEND_ORIGINS_HERE" # Comma-separated extra allowed frontend origins.
FRONTEND_URL="YOUR_FRONTEND_URL_HERE" # Frontend URL used by admin alert links.
PUBLIC_APP_URL="YOUR_PUBLIC_APP_URL_HERE" # Public app URL fallback for admin alert links.
BACKEND_DEPLOYMENT_ENV="YOUR_DEPLOYMENT_ENV_HERE" # Backend deployment environment marker.
STAGE="YOUR_STAGE_HERE" # Generic stage name used in notifications.
RAILWAY_ENVIRONMENT="YOUR_RAILWAY_ENVIRONMENT_HERE" # Railway environment name.
RAILWAY_PUBLIC_DOMAIN="YOUR_RAILWAY_PUBLIC_DOMAIN_HERE" # Railway public domain marker.
RAILWAY_STATIC_URL="YOUR_RAILWAY_STATIC_URL_HERE" # Railway static URL marker.
RAILWAY_SERVICE_ID="YOUR_RAILWAY_SERVICE_ID_HERE" # Railway service ID marker.
RAILWAY_PROJECT_ID="YOUR_RAILWAY_PROJECT_ID_HERE" # Railway project ID marker.
RAILWAY_GIT_COMMIT_SHA="YOUR_RAILWAY_GIT_COMMIT_SHA_HERE" # Railway git commit SHA for health output.
RAILWAY_GIT_COMMIT="YOUR_RAILWAY_GIT_COMMIT_HERE" # Railway git commit fallback for health output.
VERCEL_ENV="YOUR_VERCEL_ENV_HERE" # Vercel environment name used in notifications.
VERCEL_GIT_COMMIT_SHA="YOUR_VERCEL_GIT_COMMIT_SHA_HERE" # Vercel git commit SHA for health output.

# Admin Seed
ADMIN_SEED_EMAIL="YOUR_ADMIN_EMAIL_HERE" # Email for optional seeded admin user.
ADMIN_SEED_PASSWORD="YOUR_ADMIN_PASSWORD_HERE" # Password for optional seeded admin user.
ADMIN_SEED_NAME="YOUR_ADMIN_NAME_HERE" # Display name for optional seeded admin user.

# Admin Alerts
ALERTS_ENABLED="true" # Enable or disable admin alert email delivery.
ADMIN_ALERT_EMAIL="YOUR_ADMIN_ALERT_EMAIL_HERE" # Recipient email for admin alerts.
ALERT_FROM_EMAIL="YOUR_ALERT_FROM_EMAIL_HERE" # Sender email for admin alerts.
ALERT_DAILY_COST_THRESHOLD_USD="10" # Daily system spend alert threshold in USD.
ALERT_USER_COST_THRESHOLD_USD="YOUR_USER_COST_THRESHOLD_USD_HERE" # Optional per-user spend alert threshold in USD.
ALERT_SPIKE_MULTIPLIER="3" # Cost spike multiplier for alerting.
ALERT_FAILED_JOB_THRESHOLD="3" # Failed-job count threshold for alerting.
ALERT_DEDUP_WINDOW_MINUTES="60" # Alert deduplication window in minutes.

# Telegram
TELEGRAM_BOT_USERNAME="YOUR_TELEGRAM_BOT_USERNAME_HERE" # Telegram bot username without @.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE" # Telegram bot token.
TELEGRAM_WEBHOOK_SECRET="YOUR_TELEGRAM_WEBHOOK_SECRET_HERE" # Secret token Telegram sends to the webhook.
TELEGRAM_WEBHOOK_URL="YOUR_TELEGRAM_WEBHOOK_URL_HERE" # Public Telegram webhook URL.
TELEGRAM_ADMIN_CHAT_ID="YOUR_TELEGRAM_ADMIN_CHAT_ID_HERE" # Telegram chat ID for admin notifications.

# AI Feature Flags
GENERATION_PIPELINE_V2="false" # Enable the newer summary generation pipeline.
USE_GPT55_SUMMARY="true" # Enable GPT-5.5 routing for summary generation when configured.

# Currency
USD_TO_SAR_RATE="3.75" # USD-to-SAR conversion rate for display.
ADMIN_USD_TO_SAR_RATE="3.75" # Admin override for USD-to-SAR display conversion.
