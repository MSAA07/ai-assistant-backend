# Replace the placeholders with actual values only when running locally.
# Railway already injects these vars in production/staging, so keep this file as a reference.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
BETTER_AUTH_BASE_URL="https://your-backend.up.railway.app/api/auth"
BETTER_AUTH_SECRET="set-a-long-random-string"
AUTH_EMAIL_FROM_EMAIL="auth@studymaxing.com"
AUTH_EMAIL_FROM_NAME="Studymaxing"
AUTH_EMAIL_REPLY_TO="support@studymaxing.com"
AUTH_EMAIL_SUPPORT_EMAIL="support@studymaxing.com"
AUTH_EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_..."
AUTH_CHALLENGE_PROVIDER="turnstile"
AUTH_TURNSTILE_SECRET_KEY=""
AUTH_CHALLENGE_REQUIRE_SIGN_UP="true"
AUTH_CHALLENGE_REQUIRE_SIGN_IN="true"
AUTH_CHALLENGE_REQUIRE_FORGOT_PASSWORD="true"
AUTH_CHALLENGE_REQUIRE_RESEND_VERIFICATION="false"
AUTH_RATE_LIMIT_SIGN_UP_IP_LIMIT="5"
AUTH_RATE_LIMIT_SIGN_IN_IP_LIMIT="10"
OPENAI_API_KEY="sk-..."
SENTRY_DSN="https://<key>@o0.ingest.sentry.io/<project-id>"
SENTRY_ENVIRONMENT="development"
# Optional QA account email for automated QA login; falls back to the known default if unset.
QA_ACCOUNT_EMAIL=
# Optional QA account password for automated QA login; falls back to the known default if unset.
QA_ACCOUNT_PASSWORD=
# Optional staging target URL for QA health checks; falls back to the known default if unset.
QA_STAGING_TARGET_URL=
# Optional production target URL for QA health checks; falls back to the known default if unset.
QA_PRODUCTION_TARGET_URL=
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="ai-study-assistant"
