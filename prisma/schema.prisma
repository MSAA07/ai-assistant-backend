// Prisma schema for AI Study Assistant

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastActive    DateTime @default(now())

  // Custom fields
  role       String? // For admin plugin
  banned     Boolean? // For admin plugin
  banReason  String? // For admin plugin
  banExpires DateTime? // For admin plugin
  plan       String    @default("free") // For subscription management

  // Legacy/Business fields
  documentsUsed Int      @default(0)
  monthlyLimit  Int      @default(5)
  storageUsed   BigInt   @default(0)
  lastReset     DateTime @default(now())

  documents Document[]
  sessions  Session[]
  accounts  Account[]

  userLimit            UserLimit?
  costAnomalyAlerts    CostAnomalyAlert[]
  adminAlerts          AdminAlert[]
  usageEvents          UsageEvent[]
  modelUsageEvents     ModelUsageEvent[]
  jobs                 Job[]
  telegramConnection   TelegramConnection?
  telegramLinkTokens   TelegramLinkToken[]
  telegramDeliveryLogs TelegramDeliveryLog[]

  @@index([lastActive])
  @@map("user")
}

model Session {
  id             String   @id
  userId         String
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Document {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename         String
  originalName     String
  fileType         String
  fileSize         Int
  language         String    @default("english")
  summary          String    @db.Text
  flashcards       Json
  examQuestions    Json
  uploadDate       DateTime  @default(now())
  processingStatus String    @default("queued")
  processingJobId  String?
  processingError  String?
  processedAt      DateTime?

  excerpts             DocumentExcerpt[]
  generations          DocumentGeneration[]
  modelUsageEvents     ModelUsageEvent[]
  flashcardSets        FlashcardSet[]
  examRecords          ExamRecord[]
  exportArtifacts      ExportArtifact[]
  telegramDeliveryLogs TelegramDeliveryLog[]
  storageKey           String? // R2 object key - added for P1-S04

  @@index([userId])
  @@index([userId, processingStatus])
  @@index([processingJobId])
}

model ExamAttempt {
  id                   String      @id @default(uuid())
  documentId           String
  userId               String
  examRecordId         String?
  examRecord           ExamRecord? @relation(fields: [examRecordId], references: [id], onDelete: SetNull)
  score                Int
  totalQuestions       Int
  answers              Json
  status               String      @default("submitted") // 'in_progress' | 'submitted' | 'abandoned'
  startedAt            DateTime    @default(now())
  lastSavedAt          DateTime    @default(now())
  submittedAt          DateTime?   @default(now())
  feedbackMode         String      @default("end") // 'instant' | 'end'
  restartFromAttemptId String?
  completedAt          DateTime    @default(now())

  @@index([userId])
  @@index([documentId])
  @@index([examRecordId])
  @@index([userId, examRecordId, status])
  @@index([userId, documentId, startedAt])
}

model FlashcardProgress {
  id           String   @id @default(uuid())
  documentId   String
  userId       String
  cardIndex    Int
  mastered     Boolean  @default(false)
  lastReviewed DateTime @default(now())

  @@unique([userId, documentId, cardIndex])
  @@index([userId])
}

model FlashcardSet {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  generationId String?
  title        String?
  options      Json     @default("{}")
  cardCount    Int      @default(0)
  sourceType   String   @default("generation") // 'generation' | 'manual' | 'legacy_migration'
  isLatest     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cards FlashcardCard[]

  @@index([documentId, createdAt])
  @@index([documentId, isLatest])
}

model FlashcardCard {
  id          String       @id @default(cuid())
  setId       String
  set         FlashcardSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  position    Int
  question    String       @db.Text
  answer      String       @db.Text
  explanation String?      @db.Text
  sourceRefs  Json         @default("[]")
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  states FlashcardCardState[]

  @@unique([setId, position])
  @@index([setId, isDeleted, position])
}

model FlashcardCardState {
  id               String        @id @default(cuid())
  userId           String
  cardId           String
  card             FlashcardCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  isHidden         Boolean       @default(false)
  isDeletedForUser Boolean       @default(false)
  mastered         Boolean       @default(false)
  correctCount     Int           @default(0)
  incorrectCount   Int           @default(0)
  lastResult       String        @default("unseen") // 'correct' | 'incorrect' | 'unseen'
  lastReviewedAt   DateTime?
  updatedAt        DateTime      @updatedAt

  @@unique([userId, cardId])
  @@index([userId, lastResult, updatedAt])
}

model ExamRecord {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  generationId  String?
  title         String?
  options       Json     @default("{}")
  questionCount Int      @default(0)
  sourceType    String   @default("generation") // 'generation' | 'manual' | 'legacy_migration'
  isLatest      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questions ExamQuestion[]
  attempts  ExamAttempt[]
  exports   ExportArtifact[]

  @@index([documentId, createdAt])
  @@index([documentId, isLatest])
}

model ExamQuestion {
  id            String     @id @default(cuid())
  examRecordId  String
  examRecord    ExamRecord @relation(fields: [examRecordId], references: [id], onDelete: Cascade)
  position      Int
  questionType  String
  question      String     @db.Text
  options       Json       @default("[]")
  correctAnswer String     @db.Text
  explanation   String     @db.Text
  sourceRefs    Json       @default("[]")
  createdAt     DateTime   @default(now())

  @@unique([examRecordId, position])
}

model ExportArtifact {
  id               String      @id @default(cuid())
  userId           String
  documentId       String
  document         Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  examRecordId     String?
  examRecord       ExamRecord? @relation(fields: [examRecordId], references: [id], onDelete: SetNull)
  attemptId        String?
  format           String      @default("pdf")
  config           Json        @default("{}")
  status           String      @default("queued") // 'queued' | 'running' | 'complete' | 'failed' | 'expired'
  jobId            String?
  storageKey       String?
  fileName         String?
  mimeType         String?
  fileSize         Int?
  errorMessage     String?
  createdAt        DateTime    @default(now())
  readyAt          DateTime?
  expiresAt        DateTime?
  lastDownloadedAt DateTime?

  @@index([userId, createdAt])
  @@index([documentId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  adminId       String
  action        String
  targetId      String?
  details       Json?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model DocumentExcerpt {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  slideOrPage Int
  excerptType String // 'slide_text' | 'speaker_note' | 'image_flag'
  content     String
  charOffset  Int      @default(0)
  createdAt   DateTime @default(now())
}

model DocumentGeneration {
  id               String            @id @default(cuid())
  documentId       String
  document         Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  generationType   String
  status           String            @default("queued")
  jobId            String?
  options          Json              @default("{}")
  output           Json?
  errorMessage     String?
  generatedAt      DateTime?
  isLatest         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  modelUsageEvents ModelUsageEvent[]

  @@index([documentId, generationType, isLatest])
  @@index([jobId])
}

model Job {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  documentId       String?
  jobType          String // 'extract_document' | 'generate_summary' | 'generate_exam' | 'generate_flashcards' | 'export_pdf'
  status           String            @default("queued") // 'queued' | 'running' | 'succeeded' | 'failed'
  progressPct      Int               @default(0)
  retryCount       Int               @default(0)
  maxRetries       Int               @default(3)
  payload          Json              @default("{}")
  result           Json?
  errorMessage     String?
  queuedAt         DateTime          @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  workerId         String?
  leaseExpiresAt   DateTime?
  lastHeartbeatAt  DateTime?
  modelUsageEvents ModelUsageEvent[]
  stageEvents      JobStageEvent[]

  @@index([status, queuedAt])
  @@index([status, leaseExpiresAt])
  @@index([documentId, jobType, queuedAt])
}

model JobStageEvent {
  id            String    @id @default(cuid())
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  stageName     String
  status        String    @default("running")
  attemptNumber Int       @default(1)
  startedAt     DateTime
  endedAt       DateTime?
  durationMs    Int?
  errorSummary  String?   @db.Text
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())

  @@index([jobId, startedAt])
  @@index([jobId, stageName, attemptNumber])
  @@index([status, startedAt])
  @@index([stageName, startedAt])
}

model FeatureFlag {
  id            String                  @id @default(cuid())
  featureKey    String                  @unique
  description   String?
  enabledGlobal Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  assignments   FeatureFlagAssignment[]
  auditLogs     FeatureFlagAuditLog[]
}

model FeatureFlagAssignment {
  id         String            @id @default(cuid())
  flagId     String
  flag       FeatureFlag       @relation(fields: [flagId], references: [id], onDelete: Cascade)
  entityType FeatureEntityType
  entityId   String
  grantedBy  String?
  grantedAt  DateTime          @default(now())
  expiresAt  DateTime?

  @@unique([flagId, entityType, entityId])
  @@index([flagId])
}

model FeatureFlagAuditLog {
  id              String             @id @default(cuid())
  flagId          String
  flag            FeatureFlag        @relation(fields: [flagId], references: [id], onDelete: Cascade)
  changedBy       String?
  auditActorLabel String?
  changeType      String
  entityType      FeatureEntityType?
  entityId        String?
  previousValue   Json?
  newValue        Json?
  changedAt       DateTime           @default(now())

  @@index([flagId])
  @@index([changedAt])
}

model UserLimit {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id])
  dailyTokenCap       Int      @default(200000)
  dailyDocCap         Int      @default(10)
  requestsPerMin      Int      @default(10)
  tokensUsedToday     Int      @default(0)
  docsUsedToday       Int      @default(0)
  lastResetDate       DateTime @default(now())
  documentCapOverride Int?
  costCapUsdOverride  Decimal? @db.Decimal(10, 4)
  tokenCapOverride    Int?
  featureCapsOverride Json     @default("{}")
  overrideBy          String?
}

model UsageCapConfig {
  id          String   @id @default(cuid())
  plan        String   @unique
  documentCap Int?
  costCapUsd  Decimal? @db.Decimal(10, 4)
  tokenCap    Int?
  featureCaps Json     @default("{}")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ModelRoutingConfig {
  id               String   @id @default(uuid())
  feature          String
  plan             String
  model            String
  reasoningEffort  String?
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([feature, plan])
  @@map("model_routing_config")
}

model CostAnomalyAlert {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  alertType    String // 'daily_spend_3x_avg' | 'doc_cap_hit' | 'token_cap_hit'
  thresholdUsd Decimal  @db.Decimal(10, 4)
  actualUsd    Decimal  @db.Decimal(10, 4)
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model AdminAlert {
  id                String    @id @default(cuid())
  alertType         String
  severity          String    @default("warning")
  targetType        String?
  targetId          String?
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  documentId        String?
  jobId             String?
  thresholdUsd      Decimal?  @db.Decimal(12, 8)
  actualUsd         Decimal?  @db.Decimal(12, 8)
  thresholdCount    Int?
  actualCount       Int?
  dedupKey          String
  emailTo           String?
  emailSubject      String?
  emailStatus       String    @default("pending")
  providerMessageId String?
  errorMessage      String?
  resolved          Boolean   @default(false)
  metadata          Json      @default("{}")
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([alertType, createdAt])
  @@index([dedupKey, createdAt])
  @@index([emailStatus, createdAt])
  @@index([userId, createdAt])
  @@index([jobId])
}

model UsageEvent {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  eventType        String // 'summary_generated' | 'flashcards_generated' | 'exam_generated' | 'pdf_exported' | 'document_extracted'
  featureKey       String?
  aiModelUsed      String? // 'gpt-4o-mini' | 'gpt-4o' | 'gpt-5.5'
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Decimal? @db.Decimal(10, 6)
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model ModelUsageEvent {
  id               String              @id @default(cuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId       String?
  document         Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  generationId     String?
  generation       DocumentGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  jobId            String?
  job              Job?                @relation(fields: [jobId], references: [id], onDelete: SetNull)
  featureKey       String
  eventType        String
  provider         String
  model            String
  inputTokens      Int                 @default(0)
  outputTokens     Int                 @default(0)
  totalTokens      Int                 @default(0)
  estimatedCostUsd Decimal             @db.Decimal(12, 8)
  currency         String              @default("USD")
  pricingVersion   String
  status           String
  billable         Boolean             @default(true)
  requestId        String?
  idempotencyKey   String              @unique
  attemptNumber    Int                 @default(1)
  jobRetryCount    Int                 @default(0)
  errorCode        String?
  metadata         Json                @default("{}")
  createdAt        DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([featureKey, createdAt])
  @@index([model, createdAt])
  @@index([documentId])
  @@index([generationId])
  @@index([jobId])
  @@index([status])
}

model TelegramConnection {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramUserId   String
  telegramChatId   String
  telegramUsername String?
  connectedAt      DateTime  @default(now())
  disconnectedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([telegramUserId])
  @@index([telegramChatId])
  @@index([disconnectedAt])
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model TelegramDeliveryLog {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type         String
  status       String
  itemCount    Int       @default(0)
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, type, status])
  @@index([documentId, createdAt])
  @@index([status, createdAt])
}

model QaRun {
  id               String        @id @default(cuid())
  target           String
  tier             String        @default("full")
  ranAt            DateTime      @default(now())
  totalDurationMs  Int
  passed           Int
  failed           Int
  skipped          Int
  estimatedCostUsd Float
  triggeredBy      String
  failureReport    String?       @db.Text
  results          QaRunResult[]

  @@index([tier, ranAt])
  @@index([triggeredBy, ranAt])
}

model QaRunResult {
  id           String @id @default(cuid())
  qaRunId      String
  qaRun        QaRun  @relation(fields: [qaRunId], references: [id], onDelete: Cascade)
  testName     String
  status       String
  message      String
  durationMs   Int
  thresholdMs  Int    @default(1000)
  speedVerdict String @default("fast")
  order        Int
}

model QaScheduleConfig {
  id            String   @id @default(cuid())
  enabled       Boolean  @default(false)
  frequencyMins Int      @default(60)
  tier          String   @default("health")
  updatedAt     DateTime @updatedAt
}

enum FeatureEntityType {
  user
  tier
}
